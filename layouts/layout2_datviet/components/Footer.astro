---
/**
 * Footer (theme layout2 — "DatViet")
 * 4 cột: thương hiệu + liên hệ · DỊCH VỤ · THÔNG TIN · đăng ký nhận tin + social.
 * Bên dưới vẫn giữ nguyên các khối HTML admin soạn bằng SunEditor
 * (footer_quick_body / footer_contact_body / footer_social_body) để không mất dữ liệu.
 */
import { getContent, href } from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'common');
const tel = String(t.hotline || '').replace(/[^0-9+]/g, '');

const services = [
  { label: t.nav_tours, url: href(lang, 'tours') },
  { label: t.nav_find_tour, url: href(lang, 'tim-tour') },
  { label: t.nav_book, url: href(lang, 'dat-tour') },
  { label: t.nav_tickets, url: href(lang, 've-may-bay') },
  { label: t.nav_car, url: href(lang, 'cho-thue-xe') },
];

const infos = [
  { label: t.nav_about, url: href(lang, 'about') },
  { label: t.nav_news, url: href(lang, 'tin-tuc') },
  { label: t.nav_testimonials, url: href(lang, 'y-kien-khach-hang') },
  { label: t.nav_partners, url: href(lang, 'doi-tac') },
  { label: t.nav_recruit, url: href(lang, 'tuyen-dung') },
  { label: t.nav_directions, url: href(lang, 'chi-duong') },
  { label: t.nav_contact, url: href(lang, 'contact') },
];

const socials = [
  { label: 'Facebook', url: t.footer_facebook, color: '#1877f2' },
  { label: 'TikTok', url: t.footer_tiktok, color: '#111111' },
  { label: 'Zalo', url: t.footer_zalo, color: '#0068ff' },
].filter((s) => !!s.url);

const hasExtraBodies = !!(t.footer_quick_body || t.footer_contact_body || t.footer_social_body);
---

<footer class="dv-footer mt-16">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Cột 1: thương hiệu + liên hệ -->
    <div>
      <div class="flex items-center gap-2.5">
        <img
          src="/content/vi/images/logo.webp"
          alt={t.brand_name}
          width="74"
          height="80"
          loading="lazy"
          decoding="async"
          class="h-12 w-auto"
        />
        <span class="leading-tight">
          <span class="block font-display text-base font-bold text-sea-deep">{t.brand_name}</span>
          <span class="block text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-ink-soft">
            {t.brand_tagline}
          </span>
        </span>
      </div>
      <p class="mt-3 leading-relaxed text-ink-soft">{t.footer_about_text}</p>
      <ul class="mt-3 grid gap-1.5">
        <li>
          <span class="font-semibold">{t.address_label}:</span>
          <span class="text-ink-soft">{t.address}</span>
        </li>
        <li>
          <span class="font-semibold">{t.hotline_label}:</span>
          <a class="font-bold text-[var(--color-hot)]" href={`tel:${tel}`}>{t.hotline}</a>
        </li>
        <li>
          <span class="font-semibold">{t.email_label}:</span>
          <a href={`mailto:${t.email}`}>{t.email}</a>
        </li>
      </ul>
    </div>

    <!-- Cột 2: dịch vụ -->
    <div>
      <h3>{t.footer_quick_title || 'Dịch vụ'}</h3>
      <ul class="grid gap-1.5">
        {
          services.map((s) => (
            <li>
              <a href={s.url}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Cột 3: thông tin -->
    <div>
      <h3>{t.footer_contact_title || 'Thông tin'}</h3>
      <ul class="grid gap-1.5">
        {
          infos.map((s) => (
            <li>
              <a href={s.url}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Cột 4: nhận tin + social -->
    <div>
      <h3>{t.footer_offer || (lang === 'vi' ? 'Đăng ký nhận tin khuyến mãi' : 'Get our newsletter')}</h3>
      <form data-newsletter class="dv-newsletter flex" novalidate>
        <input
          type="email"
          name="email"
          required
          placeholder={lang === 'vi' ? 'Email của bạn' : 'Your email'}
          aria-label={lang === 'vi' ? 'Email của bạn' : 'Your email'}
        />
        <button type="submit">{lang === 'vi' ? 'Gửi' : 'Send'}</button>
      </form>
      <p data-newsletter-note class="mt-2 hidden text-xs text-sea-deep">
        {lang === 'vi' ? 'Cảm ơn bạn! Vui lòng kiểm tra email để hoàn tất.' : 'Thanks! Please check your email.'}
      </p>

      {
        socials.length > 0 && (
          <>
            <h3 class="mt-5">{t.footer_social_title}</h3>
            <div class="flex items-center gap-2">
              {socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded px-3 py-1.5 text-xs font-semibold text-white"
                  style={`background:${s.color}`}
                >
                  {s.label}
                </a>
              ))}
            </div>
          </>
        )
      }

      {
        t.website && (
          <p class="mt-5 text-xs text-ink-soft">
            <span class="font-semibold">{t.website_label}:</span> {t.website}
          </p>
        )
      }
    </div>
  </div>

  {
    hasExtraBodies && (
      <div class="border-t border-black/5">
        <div class="mx-auto grid max-w-6xl gap-6 px-5 py-8 sm:grid-cols-3">
          {t.footer_quick_body && (
            <div class="rich-doc text-sm" set:html={richDoc(t.footer_quick_body)} />
          )}
          {t.footer_contact_body && (
            <div class="rich-doc text-sm" set:html={richDoc(t.footer_contact_body)} />
          )}
          {t.footer_social_body && (
            <div class="rich-doc text-sm" set:html={richDoc(t.footer_social_body)} />
          )}
        </div>
      </div>
    )
  }

  <div class="dv-copyright">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-1 px-5 py-3 text-center sm:flex-row sm:text-left"
    >
      <p>© {new Date().getFullYear()} {t.brand_name}. {t.rights}</p>
      {t.footer_credit && <p class="opacity-80">{t.footer_credit}</p>}
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector('[data-newsletter]') as HTMLFormElement | null;
  const note = document.querySelector('[data-newsletter-note]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector('input[name="email"]') as HTMLInputElement | null;
    const email = (input?.value || '').trim();
    if (!email) return;
    const to = form.dataset.mailto || 'admin@todaytourist.com';
    window.location.href = `mailto:${to}?subject=${encodeURIComponent('Đăng ký nhận tin khuyến mãi')}&body=${encodeURIComponent(email)}`;
    note?.classList.remove('hidden');
    form.reset();
  });
</script>
