---
/**
 * AboutPage — trang "Giới thiệu": toàn bộ nội dung nằm trong MỘT block duy nhất
 * (body_html) do admin soạn bằng SunEditor full-document (nhiều button/option),
 * + gallery ảnh công ty (admin thêm / bớt ảnh riêng).
 */
import { getContent } from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';
import { bodyFor } from '@/lib/pagebody.js';
import BaseLayout from './BaseLayout.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'about');
const body = bodyFor('about', t);
---

<BaseLayout lang={lang} title={t.title}>
  <!-- Toàn bộ nội dung (một ô soạn thảo full-document) — text + ảnh đan xen.
       KHÔNG data-reveal: block cao hơn viewport nên IntersectionObserver không reveal
       (kẹt opacity:0 -> trang rỗng). -->
  <section class="px-5 py-14 sm:py-16">
    <div class="rich-doc mx-auto max-w-4xl" set:html={richDoc(body)} />
  </section>
</BaseLayout>

<style>
  .rich-doc {
    color: var(--color-ink-soft);
  }
  .rich-doc h1 {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  .rich-doc h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 1.75rem 0 0.75rem;
  }
  .rich-doc h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.35;
    color: var(--color-ink);
    margin: 1.25rem 0 0.6rem;
  }
  .rich-doc h4,
  .rich-doc h5,
  .rich-doc h6 {
    font-family: var(--font-display);
    color: var(--color-ink);
    margin: 1rem 0 0.5rem;
  }
  .rich-doc p {
    margin: 0.75rem 0;
    line-height: 1.85;
  }
  .rich-doc ul,
  .rich-doc ol {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .rich-doc ul {
    list-style: disc;
  }
  .rich-doc ol {
    list-style: decimal;
  }
  .rich-doc li {
    margin: 0.3rem 0;
    line-height: 1.7;
  }
  .rich-doc a {
    color: var(--color-sea);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rich-doc img {
    margin: 1rem 0;
    border-radius: 1rem;
    height: auto;
    max-width: 100%;
  }
  .rich-doc blockquote {
    margin: 1rem 0;
    border-left: 3px solid var(--color-sea);
    padding: 0.25rem 0 0.25rem 1rem;
    font-style: italic;
  }
  .rich-doc table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .rich-doc th,
  .rich-doc td {
    border: 1px solid var(--color-ink-soft);
    padding: 0.5rem 0.75rem;
  }
  .rich-doc th {
    background: var(--color-sand-deep);
    font-weight: 600;
    color: var(--color-ink);
  }
  .rich-doc hr {
    margin: 1.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-ink-soft);
  }
  .rich-doc pre {
    background: var(--color-sand-deep);
    padding: 1rem;
    border-radius: 0.75rem;
    overflow-x: auto;
  }
</style>
