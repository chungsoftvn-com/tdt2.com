---
import { richText } from '@/lib/rich.js';

interface Props {
  kicker?: string;
  title: string;
  text?: string;
}

const { kicker, title, text } = Astro.props;
---

<section class="relative overflow-hidden bg-sand-deep">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/4 top-0 h-64 w-64 rounded-full bg-sea/10 blur-3xl" />
    <div class="absolute bottom-0 right-1/4 h-64 w-64 rounded-full bg-accent/10 blur-3xl" />
  </div>
  <div class="relative mx-auto max-w-3xl px-5 py-16 text-center sm:py-20">
    {kicker && (
      <p data-reveal class="font-hand text-2xl text-accent-deep sm:text-3xl">{kicker}</p>
    )}
    <h1 data-reveal style="--reveal-delay:0.06s" class="mt-2 font-display text-4xl leading-tight text-ink sm:text-5xl">
      {title}
    </h1>
    {text && (
      <div data-reveal style="--reveal-delay:0.12s" class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft" set:html={richText(text)} />
    )}
  </div>
  <span class="wave-edge text-sand" aria-hidden="true">
    <svg viewBox="0 0 1200 40" preserveAspectRatio="none">
      <path d="M0 0H1200V20Q1100 0 1000 20T800 20T600 20T400 20T200 20T0 20Z" fill="currentColor" />
    </svg>
  </span>
</section>
