---
import { getContent } from '@/lib/content.js';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const services = [
  { icon: 'plane', title: t.service_ticket_title, text: t.service_ticket_text },
  { icon: 'car', title: t.service_car_title, text: t.service_car_text },
  { icon: 'users', title: t.service_team_title, text: t.service_team_text },
  { icon: 'sparkles', title: t.service_custom_title, text: t.service_custom_text },
];
---

<section class="bg-sand-deep px-5 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeading kicker={t.services_kicker} title={t.services_title} text={t.services_text} />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${i * 0.07}s`}
            class="rounded-2xl bg-paper p-6 shadow-[var(--shadow-lift-1)] transition-transform duration-300 hover:-translate-y-1"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sea-pale text-sea">
              <Icon name={s.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 font-display text-lg text-ink">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
