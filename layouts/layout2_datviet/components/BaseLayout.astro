---
import '@/styles/global.css';
// Theme riêng của layout2 — nạp SAU global.css để ghi đè token (xem styles/theme.css).
import '@/styles/theme.css';
import { getContent } from '@/lib/content.js';
import {
  DEFAULT_OG_IMAGE,
  LANGS,
  absUrl,
  alternates,
  breadcrumbLd,
  breadcrumbs,
  canonicalPath,
  imageUrl,
  isNoindexPath,
  pageSeo,
  travelAgencyLd,
  websiteLd,
  viOnlyRootSlug,
  xDefaultPath,
} from '@/lib/seo.js';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  /** Ngôn ngữ trang. */
  lang: string;
  /** Tiêu đề riêng của bài (tour, tin tức…) → '<title> · thương hiệu'. */
  title?: string;
  /** Mô tả riêng của bài (ưu tiên hơn seo.json). */
  description?: string;
  /** Ảnh chia sẻ: tên file trong content/vi/images hoặc path/URL tuyệt đối. */
  image?: string;
  /** og:type. */
  type?: 'website' | 'article' | 'product';
  /** Ngày đăng (tin tức) → article:published_time. */
  publishedTime?: string;
  /** Node JSON-LD riêng của trang (Product, NewsArticle…). */
  jsonLd?: Array<Record<string, unknown>>;
  /** Buộc noindex (trang 404…). */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const t = getContent(lang, 'common');
const pathname = Astro.url.pathname;
const seo = pageSeo(lang, pathname);

// Title ưu tiên: seo.json (đã tối ưu cho từng trang tĩnh) > <title> của bài
// (tour/tin tức — không khai báo trong seo.json) > tiêu đề thương hiệu chung.
const fullTitle = seo.title || (title ? `${title} · ${seo.brand}` : seo.metaTitle);
const desc = description ?? (seo.description || seo.metaDescription);

// '/' là bản trùng của '/vi/' → canonical trỏ về '/vi/' (GitHub Pages không
// redirect server-side được nên dùng canonical + loại '/' khỏi sitemap).
const canonical = absUrl(canonicalPath(pathname));

// Trang công cụ (đồng bộ nội dung) + biến thể ?__sync=1 không được index.
const isSync = Astro.url.searchParams.get('__sync') === '1';
const isHidden = noindex || isSync || isNoindexPath(pathname);
const robots = isHidden ? 'noindex, follow' : 'index, follow';

// Các bản ngôn ngữ THỰC SỰ tồn tại (trang VI-only ở cấp gốc không có bản /en/).
const altLinks = alternates(pathname);
const OG_LOCALES = { vi: 'vi_VN', en: 'en_US' };
const ogLocale = OG_LOCALES[lang] ?? 'vi_VN';
// Trang VI-only ở cấp gốc không có bản dịch nào khác → không quảng bá locale thừa.
const ogLocaleAlt = viOnlyRootSlug(pathname)
  ? []
  : LANGS.filter((l) => l !== lang).map((l) => OG_LOCALES[l]);

const ogImage = image ? absUrl(imageUrl(image)) : absUrl(DEFAULT_OG_IMAGE);
const hasCustomImage = Boolean(image);

const crumbs = isHidden ? [] : breadcrumbs(lang, pathname, title || '');
const graph = [travelAgencyLd(lang), websiteLd(lang), breadcrumbLd(crumbs), ...jsonLd].filter(
  Boolean,
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    {
      // Trang noindex: không phát canonical/hreflang (tránh trỏ tới URL không tồn tại).
      !isHidden && (
        <>
          <link rel="canonical" href={canonical} />
          {altLinks.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={absUrl(xDefaultPath(pathname))} />
        </>
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap"
    />
    <meta name="theme-color" content="#27822a" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={seo.brand} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlt.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={fullTitle} />
    {
      !hasCustomImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>
  <body class="flex min-h-dvh flex-col bg-sand text-ink antialiased">
    <a
      href="#main"
      class="sr-only z-[100] rounded-full bg-ink px-4 py-2 text-sand focus:not-sr-only focus:absolute focus:left-4 focus:top-4"
    >
      {t.skip_to_content}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Nút nổi: chỉ đường Google Maps + chat Zalo (thói quen người dùng du lịch) -->
    <div class="dv-sticky-actions">
      <a
        class="dv-fab-maps"
        href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(t.address || '')}`}
        target="_blank"
        rel="noopener noreferrer"
        title={t.address_label}
      >
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
          <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
        </svg>
      </a>
      <a
        class="dv-fab-chat"
        href={/^https?:/i.test(String(t.zalo || ''))
          ? String(t.zalo)
          : `https://zalo.me/${String(t.zalo || t.hotline || '').replace(/[^0-9]/g, '')}`}
        target="_blank"
        rel="noopener noreferrer"
        title={t.zalo_label}
      >
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
          <path d="M12 3C6.9 3 2.75 6.4 2.75 10.6c0 2.37 1.3 4.5 3.36 5.9-.13 1.1-.63 2.5-1.6 3.6 1.9-.2 3.3-.9 4.2-1.5.98.28 2.1.44 3.29.44 5.1 0 9.25-3.4 9.25-7.6S17.1 3 12 3Z" />
        </svg>
      </a>
    </div>

    <script>
      // Tiny, dependency-free scroll-reveal.
      const apply = () => {
        const els = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-revealed');
                io.unobserve(e.target);
              }
            }
          },
          // threshold 0: reveal khi bất kỳ pixel nào vào viewport — quan trọng cho
          // khối nội dung CAO HƠN viewport (vd trang Giới thiệu 1 block, ratio không
          // bao giờ đạt 0.12 nên bị kẹt opacity:0).
          { threshold: 0, rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      };
      document.readyState !== 'loading'
        ? apply()
        : document.addEventListener('DOMContentLoaded', apply);
    </script>
  </body>
</html>
