---
interface Props {
  kicker?: string;
  title: string;
  text?: string;
  align?: 'center' | 'left';
}

const { kicker, title, text, align = 'center' } = Astro.props;
const centered = align === 'center';
---

<div
  class={centered ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}
  data-reveal
>
  {kicker && <p class="font-hand text-2xl text-accent-deep">{kicker}</p>}
  <h2
    class={`mt-1 font-display text-3xl leading-tight text-ink sm:text-4xl ${centered ? '' : 'text-left'}`}
  >
    {title}
  </h2>
  {text && <p class="mt-3 text-ink-soft">{text}</p>}
</div>
