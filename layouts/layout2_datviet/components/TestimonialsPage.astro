---
// /vi/y-kien-khach-hang — Ý kiến khách hàng (ảnh + cảm nhận sau chuyến đi).
// Mỗi ý kiến là 1 trang riêng: click vào card -> /vi/y-kien-khach-hang/<slug>.
import { getContent, getTestimonials, href } from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';
import BaseLayout from './BaseLayout.astro';
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'testimonials');
const c = getContent(lang, 'common');
const items = getTestimonials(lang);
const listBase = href(lang, 'y-kien-khach-hang');
/** Trích đoạn văn bản (bỏ thẻ HTML) cho card — khoảng 150 ký tự. */
const plain = (s = '') =>
  String(s)
    .replace(/<[^>]*>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
---

<BaseLayout lang={lang} title={t.list_title}>
  <PageHero kicker={t.list_title} title={t.list_title} text={t.list_text} />

  {t.body_html && (
    <section class="px-5 pt-12">
      <div class="rich-doc mx-auto max-w-3xl text-center" set:html={richDoc(t.body_html)} />
    </section>
  )}

  <section class="px-5 py-14 sm:py-16">
    <div class="mx-auto max-w-6xl">
      {items.length === 0 ? (
        <p class="text-center text-ink-soft">{c.empty_list}</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((x, i) => {
            const detailUrl = `${listBase}${x.slug}/`;
            const excerpt = plain(x.feeling) || '';
            return (
              <article
                data-reveal
                style={`--reveal-delay:${(i % 3) * 0.07}s`}
                class="group flex flex-col overflow-hidden rounded-2xl bg-paper shadow-[var(--shadow-lift-1)] transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift-2)]"
              >
                {Array.isArray(x.images) && x.images.length > 0 ? (
                  <a href={detailUrl} class="block aspect-[4/3] w-full overflow-hidden bg-sand">
                    <img
                      src={x.images[0]}
                      alt={x.name}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                  </a>
                ) : (
                  <a href={detailUrl} class="flex aspect-[4/3] w-full items-center justify-center bg-sea-pale">
                    <Icon name="users" class="h-12 w-12 text-sea" />
                  </a>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-start gap-3">
                    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sea text-sand">
                      <Icon name="star" class="h-5 w-5" />
                    </span>
                    <div>
                      <h2 class="font-display text-lg leading-snug text-ink">
                        <a href={detailUrl} class="transition-colors hover:text-sea-deep">{x.name}</a>
                      </h2>
                      {x.org && <p class="text-xs text-ink-soft">{x.org}</p>}
                    </div>
                  </div>
                  <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-ink-soft">
                    {excerpt || '…'}
                  </p>
                  {(x.tour || x.destination) && (
                    <p class="mt-auto pt-4 text-xs font-semibold text-sea">
                      {[x.destination, x.tour].filter(Boolean).join(' · ')}
                    </p>
                  )}
                  <a
                    href={detailUrl}
                    class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-sea-deep transition-colors hover:text-ink"
                  >
                    {t.read_more || c.read_more || 'Xem chi tiết'}
                    <Icon name="arrow-right" class="h-3.5 w-3.5" />
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
