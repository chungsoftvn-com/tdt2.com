---
/**
 * Home (theme layout2 — "DatViet")
 *  · Hero banner + khối tìm tour 2 tab (Trong nước / Nước ngoài) + chip khu vực.
 *  · Vẫn tôn trọng `home_blocks` của admin (hero/about/services/stats/hot/values/
 *    partners/cta/custom) như layout1 — chỉ khác cách trình bày.
 *  · Thêm các mục đặc trưng: tour theo từng khu vực, logo đối tác, tin tức.
 */
import {
  getContent,
  getNews,
  getPartners,
  getTours,
  href,
  slugifyVi,
} from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';
import { DEFAULT_HOME_BLOCKS, customBodyKey } from '@/lib/homeblocks.js';
import BaseLayout from './BaseLayout.astro';
import AboutTeaser from './AboutTeaser.astro';
import Services from './Services.astro';
import Stats from './Stats.astro';
import Values from './Values.astro';
import CTABand from './CTABand.astro';
import PartnersSlider from './PartnersSlider.astro';
import TourCard from './TourCard.astro';
import NewsCard from './NewsCard.astro';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');
const c = getContent(lang, 'common');
const tours = getTours(lang);
const news = getNews(lang).slice(0, 3);
const partners = getPartners(lang);

const hotSlugs = Array.isArray(t.hot_tours) ? t.hot_tours : [];
const hotTours = hotSlugs.length
  ? tours.filter((x) => hotSlugs.includes(x.slug))
  : tours.slice(0, 8);
const read = (k) => (typeof t[k] === 'string' ? t[k] : '');

const blocks = (
  Array.isArray(t.home_blocks) && t.home_blocks.length ? t.home_blocks : DEFAULT_HOME_BLOCKS
).filter((b) => b && b.type && b.enabled !== false);

/** Nhóm tour theo khu vực trong 1 nhóm (domestic | international). */
const regionGroups = (type: string) => {
  const map = new Map<string, { name: string; slug: string; items: typeof tours }>();
  for (const tour of tours) {
    if (tour.region !== type) continue;
    const name = String(tour.regionName || '').trim();
    if (!name) continue;
    if (!map.has(name)) map.set(name, { name, slug: slugifyVi(name), items: [] });
    map.get(name)!.items.push(tour);
  }
  return [...map.values()].sort((a, b) => a.name.localeCompare(b.name, 'vi'));
};

const domesticGroups = regionGroups('domestic');
const intlGroups = regionGroups('international');

const chipLinks = [...domesticGroups, ...intlGroups].map((g) => ({
  label: g.name,
  url: href(lang, `tours/khu-vuc/${g.slug}`),
}));

const heroImage = hotTours[0]?.image ? `/content/vi/images/${hotTours[0].image}` : '';
const searchPlaceholder =
  lang === 'vi' ? 'Bạn muốn đi đâu? Nhập tên tour / điểm đến…' : 'Where to? Tour or destination…';

/** Dữ liệu lấy từ Facebook Page (content/vi/facebook.json) — bản EN chưa có thì dùng VI. */
const readFb = (l: string): any => {
  try {
    return getContent(l, 'facebook') ?? {};
  } catch {
    return {};
  }
};
const fb = (() => {
  const own = readFb(lang);
  return own && own.page_url ? own : readFb('vi');
})();
const fbPhotos: any[] = Array.isArray(fb.photos) ? fb.photos : [];
---

<BaseLayout lang={lang}>
  {
    blocks.map((b) => {
      switch (b.type) {
        case 'hero':
          return (
            <section class="relative isolate overflow-hidden bg-sea-deep">
              {heroImage && (
                <img
                  src={heroImage}
                  alt=""
                  class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35"
                  loading="eager"
                  decoding="async"
                />
              )}
              <div class="absolute inset-0 -z-10 bg-gradient-to-r from-sea-deep/90 via-sea-deep/70 to-sea-deep/40" />

              <div class="mx-auto max-w-6xl px-5 pb-8 pt-12 text-white sm:pb-10 sm:pt-16">
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/85">
                  {t.hero_kicker}
                </p>
                <h1 class="mt-3 max-w-3xl font-display text-3xl font-bold leading-tight sm:text-4xl">
                  {t.hero_title}
                </h1>
                <p class="mt-3 max-w-2xl leading-relaxed text-white/90">{t.hero_text}</p>
                <div class="mt-5 flex flex-wrap gap-3">
                  <a href={href(lang, 'tours')} class="dv-btn dv-btn-green">
                    {t.hero_cta_primary}
                  </a>
                  <a
                    href={href(lang, 'contact')}
                    class="dv-btn border border-white/70 text-white hover:bg-white/15"
                  >
                    {t.hero_cta_secondary}
                  </a>
                </div>
              </div>

              {/* Khối tìm tour 2 tab */}
              <div class="mx-auto max-w-6xl px-5">
                <div class="rounded-t-[var(--radius-card)] bg-white/95 p-3 shadow-[var(--shadow-lift-2)] sm:p-4">
                  <div class="flex gap-1">
                    <button type="button" class="dv-tab" data-tab="domestic" data-active="true">
                      {c.region_domestic}
                    </button>
                    <button type="button" class="dv-tab" data-tab="international" data-active="false">
                      {c.region_international}
                    </button>
                  </div>

                  <form
                    action={href(lang, 'tim-tour')}
                    method="get"
                    class="mt-3 grid gap-2 sm:grid-cols-[1fr_auto]"
                    role="search"
                  >
                    <input
                      type="search"
                      name="q"
                      class="dv-search-input !rounded-[var(--radius-btn)] !border-2"
                      placeholder={searchPlaceholder}
                      aria-label={searchPlaceholder}
                    />
                    <input type="hidden" name="region" value="domestic" data-region-input />
                    <button type="submit" class="dv-btn dv-btn-green">
                      <Icon name="search" class="h-4 w-4" />
                      {c.nav_find_tour}
                    </button>
                  </form>

                  <div class="mt-3 flex flex-wrap gap-2" data-chips="domestic">
                    {domesticGroups.map((g) => (
                      <a class="dv-chip" href={href(lang, `tours/khu-vuc/${g.slug}`)}>
                        <Icon name="arrow-right" class="h-3.5 w-3.5 text-sea" />
                        {g.name}
                      </a>
                    ))}
                  </div>
                  <div class="mt-3 hidden flex-wrap gap-2" data-chips="international">
                    {intlGroups.map((g) => (
                      <a class="dv-chip" href={href(lang, `tours/khu-vuc/${g.slug}`)}>
                        <Icon name="arrow-right" class="h-3.5 w-3.5 text-sea" />
                        {g.name}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </section>
          );
        case 'about':
          return <AboutTeaser lang={lang} />;
        case 'services':
          return <Services lang={lang} />;
        case 'stats':
          return <Stats lang={lang} />;
        case 'hot':
          return (
            <section class="bg-sand px-5 py-12 sm:py-14">
              <div class="mx-auto max-w-6xl">
                <div class="dv-head">
                  <h2>{t.hot_tours_title}</h2>
                  <a href={href(lang, 'tours')}>
                    {t.view_all_tours}
                  </a>
                </div>
                {t.hot_tours_text && <p class="dv-head-sub">{t.hot_tours_text}</p>}
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                  {hotTours.slice(0, 8).map((tour, i) => (
                    <TourCard lang={lang} tour={tour} hot={i < 2} />
                  ))}
                </div>
              </div>
            </section>
          );
        case 'values':
          return <Values lang={lang} />;
        case 'partners':
          return <PartnersSlider lang={lang} />;
        case 'cta':
          return <CTABand lang={lang} />;
        case 'custom':
          return (
            <section class="px-5 py-12">
              <div class="rich-doc mx-auto max-w-4xl" set:html={richDoc(read(customBodyKey(b.id)))} />
            </section>
          );
        default:
          return null;
      }
    })
  }

  {/* Tour theo khu vực — mỗi khu vực 1 hàng thẻ + link xem thêm */}
  {
    [
      { title: c.region_domestic, groups: domesticGroups },
      { title: c.region_international, groups: intlGroups },
    ]
      .filter((sec) => sec.groups.length > 0)
      .map((sec) => (
        <section class="bg-white px-5 py-12">
          <div class="mx-auto max-w-6xl">
            {sec.groups.map((g) => (
              <div class="mb-10 last:mb-0">
                <div class="dv-head">
                  <h2>{g.name}</h2>
                  <a href={href(lang, `tours/khu-vuc/${g.slug}`)}>
                    {t.view_all_tours} ({g.items.length})
                  </a>
                </div>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {g.items.slice(0, 3).map((tour) => (
                    <TourCard lang={lang} tour={tour} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
  }

  {/* Logo khách hàng / đối tác */}
  {
    partners.length > 0 && (
      <section class="bg-sand px-5 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="dv-head">
            <h2>{t.partners_title || c.nav_partners}</h2>
            <a href={href(lang, 'doi-tac')}>{c.read_more}</a>
          </div>
          {t.partners_text && <p class="dv-head-sub">{t.partners_text}</p>}
          <div class="dv-logo-wall">
            {partners.slice(0, 12).map((p) => (
              <a
                class="dv-logo-cell"
                href={p.website || href(lang, 'doi-tac')}
                target={p.website ? '_blank' : undefined}
                rel={p.website ? 'noopener noreferrer' : undefined}
                title={p.name}
              >
                <img src={`/content/vi/images/${p.image}`} alt={p.name} loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Tin tức & cẩm nang */}
  {
    news.length > 0 && (
      <section class="bg-white px-5 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="dv-head">
            <h2>{c.nav_news}</h2>
            <a href={href(lang, 'tin-tuc')}>{t.view_all_tours}</a>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {news.map((item) => (
              <NewsCard lang={lang} item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Hình ảnh mới nhất từ Facebook Page */}
  {
    fbPhotos.length > 0 && (
      <section class="border-t border-black/5 bg-sea-pale/70 px-5 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="dv-head">
            <h2>{fb.section_title || 'Facebook'}</h2>
            <a href={fb.page_url} target="_blank" rel="noopener noreferrer">
              {fb.cta_label || 'Facebook'}
            </a>
          </div>
          {fb.section_text && <p class="dv-head-sub">{fb.section_text}</p>}
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
            {fbPhotos.map((p) => (
              <a
                class="group overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-lift-1)]"
                href={p.url || fb.page_url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src={`/content/vi/images/${p.image}`}
                  alt={p.alt || fb.page_name}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </a>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a
              class="dv-btn dv-btn-accent"
              href={fb.page_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {fb.cta_label || 'Facebook'}
            </a>
            {fb.followers && (
              <span class="text-sm text-ink-soft">
                <strong class="text-sea-deep">{fb.followers}</strong> {fb.followers_label}
              </span>
            )}
            {fb.bio && <span class="max-w-2xl text-sm leading-relaxed text-ink-soft">{fb.bio}</span>}
          </div>
        </div>
      </section>
    )
  }

  {/* Tư vấn & Kinh doanh (giữ như web cũ) */}
  {
    read('sales_title') && (
      <section class="border-t border-black/5 bg-sand-deep/60 px-5 py-12">
        <div class="mx-auto max-w-6xl text-center">
          <h2 class="font-display text-2xl text-ink">{c.sales_title}</h2>
          <div class="rich-doc mx-auto mt-4 max-w-2xl" set:html={richDoc(c.sales_body_html)} />
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Tab "Trong nước / Nước ngoài" trong khối tìm tour: đổi danh sách chip + giá
  // trị `region` gửi kèm khi submit.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.dv-tab[data-tab]');
  const regionInput = document.querySelector<HTMLInputElement>('[data-region-input]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab || 'domestic';
      tabs.forEach((x) => x.setAttribute('data-active', String(x === tab)));
      document.querySelectorAll<HTMLElement>('[data-chips]').forEach((box) => {
        box.classList.toggle('hidden', box.dataset.chips !== key);
      });
      if (regionInput) regionInput.value = key;
    });
  });
</script>
