---
/**
 * Header (theme layout2 — "DatViet")
 * 3 tầng: thanh trên (hotline/email/social + VI|EN) → logo + ô tìm kiếm + hotline
 * → thanh menu xanh có mega menu (gom tour theo khu vực, tự sinh từ dữ liệu tour).
 * Menu 1 hàng: item nào tràn thì tự gom vào nút "•••" (giống layout1).
 */
import { getContent, getTours, href, langHref, slugifyVi } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'common');
const current = Astro.url.pathname;
const tours = getTours(lang);

/** Gom tour theo khu vực trong 1 nhóm (domestic | international). */
const regionsOf = (type: string) => {
  const map = new Map<string, { name: string; slug: string; count: number }>();
  for (const tour of tours) {
    if (tour.region !== type) continue;
    const name = String(tour.regionName || '').trim();
    if (!name) continue;
    if (!map.has(name)) map.set(name, { name, slug: slugifyVi(name), count: 0 });
    map.get(name)!.count += 1;
  }
  return [...map.values()].sort((a, b) => a.name.localeCompare(b.name, 'vi'));
};

const domestic = regionsOf('domestic');
const intl = regionsOf('international');

type NavItem = {
  label: string;
  url: string;
  mega?: Array<{ title: string; all: string; items: Array<{ name: string; url: string; count: number }> }>;
};

const navItems: NavItem[] = [
  { label: t.nav_home, url: href(lang) },
  {
    label: t.region_domestic,
    url: href(lang, 'tours'),
    mega: [
      {
        title: t.region_domestic,
        all: href(lang, 'tours'),
        items: domestic.map((r) => ({
          name: r.name,
          url: href(lang, `tours/khu-vuc/${r.slug}`),
          count: r.count,
        })),
      },
    ],
  },
  {
    label: t.region_international,
    url: href(lang, 'tours'),
    mega: [
      {
        title: t.region_international,
        all: href(lang, 'tours'),
        items: intl.map((r) => ({
          name: r.name,
          url: href(lang, `tours/khu-vuc/${r.slug}`),
          count: r.count,
        })),
      },
    ],
  },
  { label: t.nav_find_tour, url: href(lang, 'tim-tour') },
  { label: t.nav_book, url: href(lang, 'dat-tour') },
  { label: t.nav_news, url: href(lang, 'tin-tuc') },
  { label: t.nav_testimonials, url: href(lang, 'y-kien-khach-hang') },
  { label: t.nav_partners, url: href(lang, 'doi-tac') },
  { label: t.nav_about, url: href(lang, 'about') },
  { label: t.nav_contact, url: href(lang, 'contact') },
  { label: t.nav_recruit, url: href(lang, 'tuyen-dung') },
  { label: t.nav_directions, url: href(lang, 'chi-duong') },
];

const isActive = (url: string) => {
  if (url === href(lang)) {
    return (
      current === '/' ||
      current === url ||
      current === `${url}/` ||
      current === '/vi' ||
      current === '/en'
    );
  }
  return current === url || current.startsWith(url);
};

const tel = String(t.hotline || '').replace(/[^0-9+]/g, '');
const viLink = langHref('vi', current);
const enLink = langHref('en', current);
const searchPlaceholder =
  lang === 'vi' ? 'Tìm tour, điểm đến, khách sạn…' : 'Search tours, destinations…';
---

<header class="dv-header sticky top-0 z-50">
  {/* Tầng 1 — thanh trên */}
  <div class="dv-topbar hidden lg:block">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-1.5">
      <div class="flex items-center gap-3">
        <span>{t.hotline_label}: <a class="font-bold" href={`tel:${tel}`}>{t.hotline}</a></span>
        <span class="dv-topbar-sep">|</span>
        <span>{t.email_label}: <a href={`mailto:${t.email}`}>{t.email}</a></span>
      </div>
      <div class="flex items-center gap-3">
        {
          t.footer_facebook && (
            <a href={t.footer_facebook} target="_blank" rel="noopener noreferrer">
              Facebook
            </a>
          )
        }
        {
          t.footer_tiktok && (
            <a href={t.footer_tiktok} target="_blank" rel="noopener noreferrer">
              TikTok
            </a>
          )
        }
        {
          t.footer_zalo && (
            <a href={t.footer_zalo} target="_blank" rel="noopener noreferrer">
              Zalo
            </a>
          )
        }
        <span class="dv-topbar-sep">|</span>
        <span class="flex items-center gap-1">
          <a
            href={viLink}
            lang="vi"
            aria-current={lang === 'vi' ? 'page' : undefined}
            class={lang === 'vi' ? 'font-bold underline' : ''}>{t.lang_code_vi}</a>
          <span class="dv-topbar-sep">/</span>
          <a
            href={enLink}
            lang="en"
            aria-current={lang === 'en' ? 'page' : undefined}
            class={lang === 'en' ? 'font-bold underline' : ''}>{t.lang_code_en}</a>
        </span>
      </div>
    </div>
  </div>

  {/* Tầng 2 — logo + tìm kiếm + hotline */}
  <div class="border-b border-black/5 bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
      <a href={href(lang)} class="flex shrink-0 items-center gap-2.5" aria-label={t.brand_name}>
        <img
          src="/content/vi/images/logo.webp"
          alt={t.brand_name}
          width="74"
          height="80"
          loading="eager"
          decoding="async"
          class="h-12 w-auto"
        />
        <span class="leading-none">
          <span class="block font-display text-lg font-bold tracking-wide text-sea-deep">
            {t.brand_name}
          </span>
          <span class="block text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-ink-soft">
            {t.brand_tagline}
          </span>
        </span>
      </a>

      <form
        action={href(lang, 'tim-tour')}
        method="get"
        class="hidden max-w-md flex-1 md:flex"
        role="search"
      >
        <input
          type="search"
          name="q"
          class="dv-search-input"
          placeholder={searchPlaceholder}
          aria-label={searchPlaceholder}
        />
        <button type="submit" class="dv-search-btn">{t.nav_find_tour}</button>
      </form>

      <div class="flex items-center gap-3">
        <div class="dv-hotline-box hidden pl-4 text-right leading-tight sm:block">
          <span class="block text-[0.68rem] uppercase text-ink-soft">{t.hotline_label}</span>
          <strong><a href={`tel:${tel}`}>{t.hotline}</a></strong>
        </div>
        <div class="flex items-center gap-1 lg:hidden">
          <a
            href={viLink}
            lang="vi"
            class={`rounded border border-black/10 px-2 py-1 text-xs font-bold ${
              lang === 'vi' ? 'bg-sea text-white' : 'text-ink-soft'
            }`}>{t.lang_code_vi}</a>
          <a
            href={enLink}
            lang="en"
            class={`rounded border border-black/10 px-2 py-1 text-xs font-bold ${
              lang === 'en' ? 'bg-sea text-white' : 'text-ink-soft'
            }`}>{t.lang_code_en}</a>
        </div>
        <button
          type="button"
          data-mobile-toggle
          aria-label={t.nav_home}
          aria-expanded="false"
          class="inline-flex h-10 w-10 items-center justify-center rounded border border-black/10 text-ink lg:hidden"
        >
          <span data-menu-icon-open><Icon name="menu" class="h-5 w-5" /></span>
          <span data-menu-icon-close class="hidden"><Icon name="close" class="h-5 w-5" /></span>
        </button>
      </div>
    </div>
  </div>

  {/* Tầng 3 — thanh menu xanh (desktop) */}
  <div class="dv-nav hidden lg:block">
    <div class="mx-auto flex max-w-6xl items-center gap-2 px-5">
      <nav data-nav aria-label="Primary" class="min-w-0 flex-1">
        <ul data-nav-list class="flex items-center">
          {
            navItems.map((item) => (
              <li class="dv-nav-item shrink-0" data-active={isActive(item.url) ? 'true' : 'false'}>
                <a href={item.url} aria-current={isActive(item.url) ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.mega && (
                  <div class="dv-mega">
                    {item.mega.map((group) => (
                      <div>
                        <a href={group.all} class="font-bold text-sea-deep">
                          {group.title}
                        </a>
                        {group.items.map((sub) => (
                          <a href={sub.url}>
                            <span>{sub.name}</span>
                            <span class="dv-mega-count">({sub.count})</span>
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                )}
              </li>
            ))
          }
          <li data-nav-more-item class="relative shrink-0">
            <button
              type="button"
              data-nav-more
              aria-label="Xem thêm menu"
              aria-expanded="false"
              class="tt-hidden block px-3 py-3 text-sm font-bold tracking-widest text-white"
            >
              •••
            </button>
            <div
              data-nav-more-menu
              class="tt-hidden absolute right-0 top-full z-50 w-60 rounded-b-lg border border-black/10 bg-white p-2 shadow-[var(--shadow-lift-2)]"
            >
            </div>
          </li>
        </ul>
      </nav>
      <a href={href(lang, 'dat-tour')} class="dv-btn dv-btn-accent my-1.5 shrink-0 !py-2">
        {t.cta_book}
      </a>
    </div>
  </div>

  {/* Menu mobile */}
  <div data-mobile-menu class="dv-nav hidden px-5 pb-4 lg:hidden">
    <form action={href(lang, 'tim-tour')} method="get" class="flex pb-3 pt-3" role="search">
      <input
        type="search"
        name="q"
        class="dv-search-input"
        placeholder={searchPlaceholder}
        aria-label={searchPlaceholder}
      />
      <button type="submit" class="dv-search-btn">{t.nav_find_tour}</button>
    </form>
    <nav aria-label="Mobile">
      <ul class="space-y-0.5">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.url}
                class={`block rounded px-3 py-2.5 text-sm font-semibold uppercase text-white ${
                  isActive(item.url) ? 'bg-sea-deep' : ''
                }`}
              >
                {item.label}
              </a>
              {item.mega && (
                <ul class="ml-3 border-l border-white/25 pl-2">
                  {item.mega[0].items.map((sub) => (
                    <li>
                      <a href={sub.url} class="block py-1.5 text-xs text-white/90">
                        {sub.name} ({sub.count})
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  const iconOpen = document.querySelector('[data-menu-icon-open]');
  const iconClose = document.querySelector('[data-menu-icon-close]');
  toggle?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !hidden);
    iconClose?.classList.toggle('hidden', hidden);
    toggle.setAttribute('aria-expanded', String(!hidden));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }),
  );

  // Menu 1 hàng: item tràn -> gom vào nút "•••".
  const navList = document.querySelector('[data-nav-list]');
  const moreItem = document.querySelector('[data-nav-more-item]');
  const moreBtn = document.querySelector('[data-nav-more]');
  const moreMenu = document.querySelector('[data-nav-more-menu]');

  function layoutNav() {
    if (!navList || !moreBtn || !moreMenu || !moreItem) return;
    const lis = Array.from(navList.children).filter((li) => li !== moreItem) as HTMLElement[];
    lis.forEach((li) => li.classList.remove('tt-hidden'));
    moreBtn.classList.add('tt-hidden');
    moreMenu.classList.add('tt-hidden');
    moreMenu.innerHTML = '';
    moreBtn.setAttribute('aria-expanded', 'false');
    const avail = navList.clientWidth - 90;
    let used = 0;
    const hidden: HTMLElement[] = [];
    for (const li of lis) {
      used += li.offsetWidth;
      if (used > avail) {
        hidden.push(li);
        li.classList.add('tt-hidden');
      }
    }
    if (hidden.length) {
      moreBtn.classList.remove('tt-hidden');
      hidden.forEach((li) => {
        const a = li.querySelector('a');
        if (!a) return;
        const clone = a.cloneNode(true) as HTMLAnchorElement;
        clone.className = 'block rounded px-3 py-2 text-sm font-semibold uppercase text-ink';
        clone.addEventListener('click', () => {
          moreMenu.classList.add('tt-hidden');
          moreBtn.setAttribute('aria-expanded', 'false');
        });
        moreMenu.appendChild(clone);
      });
    }
  }

  moreBtn?.addEventListener('click', () => {
    const hidden = moreMenu.classList.toggle('tt-hidden');
    moreBtn.setAttribute('aria-expanded', String(!hidden));
  });
  document.addEventListener('click', (e) => {
    if (moreItem && !moreItem.contains(e.target as Node)) {
      moreMenu?.classList.add('tt-hidden');
      moreBtn.setAttribute('aria-expanded', 'false');
    }
  });
  window.addEventListener('resize', layoutNav);
  layoutNav();
</script>

<style>
  .tt-hidden {
    display: none !important;
  }
</style>
