---
import { getContent, getNews, getNewsItem, href } from '@/lib/content.js';
import { newsLd } from '@/lib/seo.js';
import BaseLayout from './BaseLayout.astro';
import NewsCard from './NewsCard.astro';
import RichContent from './RichContent.astro';

interface Props {
  lang: string;
  slug: string;
}

const { lang, slug } = Astro.props;
const c = getContent(lang, 'common');
const item = getNewsItem(lang, slug);
if (!item) {
  throw new Error(`[news] unknown slug "${slug}" for lang "${lang}"`);
}
const listUrl = href(lang, 'tin-tuc');
const others = getNews(lang).filter((x) => x.slug !== slug).slice(0, 3);

// Markdown-lite + escape (an toàn XSS) cho body do admin nhập.
function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function renderBody(body: string): string {
  let html = '';
  let inUl = false;
  for (const raw of String(body || '').split('\n')) {
    const line = raw.trim();
    if (!line) {
      if (inUl) { html += '</ul>'; inUl = false; }
      continue;
    }
    if (line.startsWith('## ')) {
      if (inUl) { html += '</ul>'; inUl = false; }
      html += `<h2>${esc(line.slice(3))}</h2>`;
    } else if (line.startsWith('- ')) {
      if (!inUl) { html += '<ul>'; inUl = true; }
      html += `<li>${esc(line.slice(2))}</li>`;
    } else {
      if (inUl) { html += '</ul>'; inUl = false; }
      html += `<p>${esc(line)}</p>`;
    }
  }
  if (inUl) html += '</ul>';
  return html;
}
---

<BaseLayout
  lang={lang}
  title={item.title}
  description={item.summary}
  image={item.image}
  type="article"
  publishedTime={item.published_at}
  jsonLd={[newsLd(lang, item)]}
>
  <!-- Hero -->
  <section class="bg-ink px-5 py-16 text-sand sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      {
        item.category && (
          <p class="inline-flex items-center rounded-full bg-sand/15 px-3 py-1 text-sm font-medium backdrop-blur-sm">
            {item.category}
          </p>
        )
      }
      <h1 class="mt-4 font-display text-3xl leading-tight text-white sm:text-4xl">{item.title}</h1>
      <p class="mt-3 text-sm text-sand/70">{item.published_at || ''}</p>
    </div>
  </section>

  <!-- Body -->
  <section class="px-5 py-14 sm:py-16">
    <article class="mx-auto max-w-3xl">
      {item.content.length > 0 ? (
        <RichContent content={item.content} />
      ) : (
        <div class="news-body" set:html={renderBody(item.body)} />
      )}
      <a
        href={listUrl}
        class="mt-10 inline-flex items-center gap-2 rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-sea hover:bg-sea hover:text-white"
      >
        <span aria-hidden="true">←</span> {c.news_back}
      </a>
    </article>
  </section>

  <!-- Related news -->
  {
    others.length > 0 && (
      <section class="bg-sand-deep px-5 py-14 sm:py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-2xl text-ink">{c.news}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((n) => <NewsCard lang={lang} item={n} />)}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .news-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .news-body :global(p) {
    margin: 0.75rem 0;
    color: var(--color-ink-soft);
    line-height: 1.8;
  }
  .news-body :global(ul) {
    margin: 0.75rem 0;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--color-ink-soft);
  }
  .news-body :global(li) {
    margin: 0.25rem 0;
    line-height: 1.7;
  }
</style>
