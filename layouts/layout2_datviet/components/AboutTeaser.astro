---
import { getContent, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const points = [
  { icon: 'star', title: t.value_1_title },
  { icon: 'users', title: t.value_2_title },
  { icon: 'tag', title: t.value_3_title },
  { icon: 'heart', title: t.value_4_title },
];
---

<section class="px-5 py-16 sm:py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
    <div data-reveal>
      <p class="font-hand text-2xl text-accent-deep sm:text-3xl">{t.about_teaser_kicker}</p>
      <h2 class="mt-1 font-display text-3xl leading-tight text-ink sm:text-4xl">
        {t.about_teaser_title}
      </h2>
      <p class="mt-4 leading-relaxed text-ink-soft">{t.about_teaser_text}</p>
      <a
        href={href(lang, 'about')}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-sea px-6 py-3 text-sm font-semibold text-white transition-transform duration-200 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t.about_teaser_cta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid grid-cols-2 gap-4">
      {
        points.map((p, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${i * 0.07}s`}
            class="rounded-2xl bg-paper p-5 shadow-[var(--shadow-lift-1)]"
          >
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-accent-pale text-accent-deep">
              <Icon name={p.icon} class="h-5 w-5" />
            </span>
            <p class="mt-3 text-sm font-semibold leading-snug text-ink">{p.title}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
