---
/**
 * TourCard (theme layout2 — "DatViet")
 * Thẻ tour dạng danh sách của web du lịch: ảnh lớn + nhãn khu vực, tên tour,
 * các dòng thông tin nhanh (thời lượng / khởi hành / khu vực), giá đỏ và nút
 * "XEM THÊM" ở chân thẻ.
 */
import { getContent, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
  tour: {
    slug: string;
    name: string;
    region: string;
    regionName: string;
    duration: string;
    price: string;
    image: string;
    desc: string;
    departure?: string;
    highlights?: string[];
  };
  /** Đánh dấu HOT (dùng cho khối "Tour hot giờ chót"). */
  hot?: boolean;
}

const { lang, tour, hot = false } = Astro.props;
const t = getContent(lang, 'common');
const url = href(lang, `tours/${tour.slug}`);
const priceOld = (tour as { price_old?: string }).price_old;
---

<article class="dv-card" data-reveal>
  <a href={url} class="dv-card-media" tabindex="-1" aria-hidden="true">
    <img
      src={tour.image ? `/content/vi/images/${tour.image}` : '/content/vi/images/placeholder-tour.svg'}
      alt={tour.name}
      loading="lazy"
      decoding="async"
      width="900"
      height="506"
    />
    {tour.regionName && <span class="dv-badge-region">{tour.regionName}</span>}
    {hot && <span class="dv-badge-hot">HOT</span>}
  </a>

  <div class="dv-card-body">
    <h3 class="dv-card-title">
      <a href={url}>{tour.name}</a>
    </h3>

    <ul class="dv-meta">
      {
        tour.duration && (
          <li>
            <Icon name="calendar" class="h-3.5 w-3.5 text-sea" />
            <span>{t.duration}: <strong class="font-semibold text-ink">{tour.duration}</strong></span>
          </li>
        )
      }
      {
        tour.departure && (
          <li>
            <Icon name="arrow-right" class="h-3.5 w-3.5 text-sea" />
            <span>{lang === 'vi' ? 'Khởi hành' : 'Departure'}: <strong class="font-semibold text-ink">{tour.departure}</strong></span>
          </li>
        )
      }
    </ul>

    <div class="dv-price-row">
      <span class="dv-price-label">{t.price}</span>
      <span class="text-right">
        {priceOld && <s class="dv-price-old">{priceOld}</s>}
        <span class="dv-price">{tour.price}</span>
      </span>
    </div>

    <a href={url} class="dv-card-cta">{t.cta_details}</a>
  </div>
</article>
