---
// Trang ẩn — trả về HTML gốc (generate bởi Astro) cho nút "Đồng bộ lại nội dung" (trang chủ).
// Không bao giờ kiểm tra html_override, nên luôn trả nội dung do hệ thống tạo.
import { LANGS } from '@/lib/content.js';
import Home from '@/components/Home.astro';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---
<Home lang={lang} />
