---
import AdminLayout from '@/components/AdminLayout.astro';
---
<AdminLayout>
  <section id="list-view">
    <h1 class="font-display text-3xl text-ink">Yêu cầu đặt tour</h1>
    <p id="list-status" class="mt-4 text-sm text-ink-soft"></p>
    <ul id="booking-list" class="mt-6 space-y-3"></ul>
  </section>
</AdminLayout>

<script>
  import { api, setBusy } from '@/lib/admin.js';
  const $ = (id) => document.getElementById(id);

  function esc(s) {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function fmtDate(iso) {
    if (!iso) return '';
    try {
      return new Date(iso).toLocaleString('vi-VN');
    } catch {
      return iso;
    }
  }

  async function load() {
    const r = await api('GET', '/bookings');
    if (r.status === 401) {
      $('list-status').innerHTML = 'Chưa đăng nhập — <a href="/admin" class="underline">Đăng nhập tại đây</a>.';
      return;
    }
    if (!r.data?.ok) { $('list-status').textContent = 'Không tải được danh sách.'; return; }
    const items = r.data.bookings || [];
    const unread = items.filter((b) => b.status !== 'read').length;
    $('list-status').textContent = `${items.length} yêu cầu · ${unread} chưa xem.`;
    $('booking-list').innerHTML = items.length
      ? items
          .map((b) => `
            <li class="rounded-2xl bg-paper p-4 shadow-[var(--shadow-lift-1)] ${b.status !== 'read' ? 'border-2 border-sea/40' : ''}">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-semibold text-ink">
                    ${esc(b.name)} · ${esc(b.phone)}
                    ${b.status !== 'read' ? '<span class="ml-2 rounded-full bg-sea px-2 py-0.5 text-xs font-semibold text-white">Mới</span>' : ''}
                  </p>
                  <p class="mt-1 text-xs text-ink-soft">${fmtDate(b.created_at)}${b.email ? ' · ' + esc(b.email) : ''}${b.dia_chi ? ' · ' + esc(b.dia_chi) : ''}</p>
                  <div class="mt-2 grid gap-1 text-sm text-ink-soft sm:grid-cols-2">
                    <p><span class="font-medium text-ink">Tour:</span> ${esc(b.tour_name || b.tour_slug || '—')}</p>
                    <p><span class="font-medium text-ink">Loại tour:</span> ${esc(b.loai_tour || '—')} ${b.loai_diem_den ? '· ' + esc(b.loai_diem_den) : ''}</p>
                    <p><span class="font-medium text-ink">Khu vực:</span> ${esc(b.khu_vuc || '—')}</p>
                    <p><span class="font-medium text-ink">Nơi đến:</span> ${esc(b.noi_den || '—')}${b.noi_den_khac ? ' (' + esc(b.noi_den_khac) + ')' : ''}</p>
                    <p><span class="font-medium text-ink">Nơi khởi hành:</span> ${esc(b.noi_khoi_hanh || b.departure || '—')}</p>
                    <p><span class="font-medium text-ink">Ngày đi / về:</span> ${esc(b.ngay_khoi_hanh || b.departure_date || '—')}${b.ngay_ve ? ' → ' + esc(b.ngay_ve) : ''}</p>
                    <p><span class="font-medium text-ink">Số khách:</span> Người lớn ${esc(b.nguoi_lon || b.guests || '—')} · Trẻ em ${esc(b.tre_em || '0')} · Em bé ${esc(b.em_be || '0')}</p>
                  </div>
                  ${(b.yeu_cau_khac || b.note) ? `<p class="mt-2 rounded-xl bg-sand/60 px-3 py-2 text-sm text-ink-soft">${esc(b.yeu_cau_khac || b.note)}</p>` : ''}
                </div>
                ${b.status !== 'read' ? `<button data-read="${b.id}" class="shrink-0 rounded-full bg-sea px-4 py-1.5 text-sm font-semibold text-white hover:bg-sea-deep">Đã xem</button>` : ''}
              </div>
            </li>`)
          .join('')
      : '<li class="text-sm text-ink-soft">Chưa có yêu cầu đặt tour nào.</li>';
    $('booking-list').querySelectorAll('[data-read]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        setBusy(btn, true, 'Đang cập nhật...');
        try {
          await api('PUT', `/bookings/${btn.dataset.read}/read`);
        } finally {
          setBusy(btn, false);
        }
        load();
      }),
    );
  }

  load();
</script>
